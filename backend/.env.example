# TailorBook Backend Environment Configuration
# Copy this file to .env and replace placeholders with your actual secrets.

# Application
PORT=3000
NODE_ENV=development

# PostgreSQL Database (Supabase)
# Replace [YOUR-PASSWORD] with your actual Supabase database password.
# Direct Connection (IPv6 default):
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.csdczyqfrlzquxkdjbqd.supabase.co:5432/postgres

# If your local network does not support IPv6, use the Supabase Session Pooler URI instead:
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

