{
  "expo": {
    "name": "TailorBook",
    "slug": "tailorbook",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/android-icon-background.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A3C5E"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tailorbook.app"
    },
    "android": {
      "package": "com.tailorbook.app",
      "usesCleartextTraffic": true,
      "permissions": [
        "android.permission.CAMERA"
      ],
      "splash": {
        "image": "./assets/android-icon-background.png",
        "resizeMode": "contain",
        "backgroundColor": "#1A3C5E"
      },
      "adaptiveIcon": {
        "backgroundColor": "#1A3C5E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/withCleartextTraffic.js",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1A3C5E",
          "image": "./assets/android-icon-background.png",
          "dark": {
            "image": "./assets/android-icon-background.png",
            "backgroundColor": "#1A3C5E"
          },
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "TailorBook requires access to your photos to attach bill photographs.",
          "cameraPermission": "TailorBook requires access to your camera to photograph physical customer receipts."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResources": true
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "31ccce38-8b1f-4013-ba18-60ad9582bb58"
      }
    },
    "owner": "abdurrahemanzoraiz"
  }
}